<div class="grid grid-cols-1 grid-rows-[min-content_min-content_min-content_min-content_min-content] gap-4">
  <div class="row-start-1">
    <h1><b><%= t('about.whoami.header') %></b></h1>
    <p>
      <%= t('about.whoami.info') %>
    </p>
  </div>

  <div class="row-start-2">
    <h1><b><%= t('about.proficiencies.header') %></b></h1>
    <p><%= t('about.proficiencies.info') %></p>
    <ul class="list-disc list-inside">
      <% t('about.proficiencies.list').each do |proficiency| %>
        <li><%= proficiency %></li>
      <% end %>
    </ul>
  </div>

  <div class="row-start-3">
    <h1><b><%= t('about.interests.header') %></b></h1>
    <p><%= t('about.interests.info') %></p>
    <ul class="list-disc list-inside">
      <% t('about.interests.list').each do |interest| %>
        <li><%= interest %></li>
      <% end %>
    </ul>
  </div>

  <div class="row-start-4">
    <h1><b><%= t('about.work-ethic.header') %></b></h1>
    <p>
      <%= t('about.work-ethic.info') %>
    </p>
  </div>

  <div class="row-start-5">
    <h1><b><%= t('about.other.header') %></b></h1>
    <p>
      <%= t('about.other.info') %>
    </p>
    <ul class="list-disc list-inside">
      <% t('about.other.list').each do |other| %>
        <li><%= other %></li>
      <% end %>
    </ul>
  </div>
</div>