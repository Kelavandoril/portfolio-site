<% @projects.each do |project| %>
  <div class="grid grid-flow-col grid-rows-[1fr_auto_1fr_1fr] grid-cols-3">
    <div class="row-start-1 col-span-3 font-bold">
      <%= project.title %>
    </div>
    <div class="row-start-2 col-span-3">
      <%= project.description %>
    </div>
    <div class="row-start-3 col-start-3 col-span-1 justify-self-end">
      <%= link_to t('project.detailed'), project_path(project.id) %>
    </div>
    <hr class="row-start-4 col-start-1 col-span-3">
  </div>
<% end %>
<% if authenticated? %>
  <%= link_to t('button.new'), new_project_path, class: "button-style self-start w-auto text-body bg-black text-white box-border border border-default-medium hover:bg-white hover:text-heading hover:text-black focus:ring-4 focus:ring-neutral-tertiary shadow-xs font-medium leading-5 rounded-base text-sm px-4 py-2.5 focus:outline-none" %>
<% end %>
